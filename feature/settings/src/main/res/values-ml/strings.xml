    <string name="settings_commitment_pin_note">പരിധികൾ അയയ്ക്കുന്ന മാറ്റങ്ങൾക്ക് PIN ആവശ്യമാണ്. കൂടുതൽ സുരക്ഷയ്ക്കായി നിങ്ങൾ വിശ്വസിക്കുന്ന ഒരാളോട് അത് തിരഞ്ഞെടുക്കാൻ ആവശ്യപ്പെടുക.</string>
    <string name="settings_commitment_choose_delay">മാറ്റങ്ങൾ എത്ര നേരം കാത്തിരിക്കണം?</string>
    <string name="settings_commitment_delay_15_minutes">15 മിനിറ്റ്</string>
    <string name="settings_commitment_delay_1_hour">1 മണിക്കൂർ</string>
    <string name="settings_commitment_delay_24_hours">24 മണിക്കൂർ</string>

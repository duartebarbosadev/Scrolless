    <string name="settings_commitment_confirm_pin">PIN വീണ്ടും നൽകുക</string>
    <string name="settings_commitment_pin_mismatch">PIN-കൾ പൊരുത്തപ്പെടുന്നില്ല. വീണ്ടും ശ്രമിക്കുക.</string>
    <string name="settings_commitment_enter_pin_message">പ്രതിബദ്ധതാ മോഡ് ഓണാണ്. ഈ മാറ്റം വരുത്താൻ PIN നൽകുക.</string>
    <string name="settings_commitment_enter_pin">PIN നൽകുക</string>
    <string name="settings_commitment_pin_wrong">തെറ്റായ PIN</string>

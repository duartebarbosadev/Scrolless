    <string name="settings">அமைப்புகள்</string>
    <string name="settings_section_blocking">தடுப்பு</string>
    <string name="settings_pause_duration_title">இடைநிறுத்த கால அளவு</string>
    <string name="settings_pause_duration_description">நீங்கள் இடைநிறுத்து என்பதைத் தட்டும்போது, தடுப்பு எவ்வளவு நேரம் நிறுத்தி வைக்கப்படும்.</string>
    <plurals name="settings_pause_duration_value">
        <item quantity="one">%1$d நிமிடம்</item>
        <item quantity="other">%1$d நிமிடங்கள்</item>
    </plurals>
    <string name="settings_allow_videos_sent_by_dms_description">நேரடிச் செய்திகளில் அனுப்பப்பட்ட வீடியோக்களைத் தடுக்க வேண்டாம்.</string>
    <string name="settings_allow_videos_sent_by_dms_note">TikTok Lite இல் இந்த அம்சம் ஆதரிக்கப்படவில்லை</string>
    <string name="settings_allow_videos_sent_by_dms_title">நேரடிச் செய்திகளில் அனுப்பப்பட்ட வீடியோக்கள்</string>
    <string name="settings_show_onscreen_timer_description">குறுகிய வீடியோக்களைப் பார்க்கும்போது மிதக்கும் டைமரைத் திரையில் தெரியும்படி வைத்திருங்கள்.</string>
    <string name="settings_show_onscreen_timer_title">திரையில் டைமரைக் காட்டு</string>
    <string name="settings_include_stories_title">ஸ்டோரிகளைச் சேர்க்கவும்</string>
    <string name="settings_include_stories_description">ஸ்டோரிகளைப் பார்ப்பதில் செலவிடும் நேரத்தைக் கணக்கிட்டு, தற்போதைய தடுப்பு முறையையும் நேர வரம்புகளையும் பயன்படுத்தவும்.</string>
    <string name="settings_include_stories_note">தற்போது Instagram, Snapchat மற்றும் Facebook-இல் ஆதரிக்கப்படுகிறது.</string>
    <string name="settings_section_commitment">உறுதிமொழி</string>
    <string name="settings_commitment_title">உறுதிமொழிப் பயன்முறை</string>
    <string name="settings_commitment_description">உந்துதலில் வரம்புகளைத் தளர்த்துவதைக் கடினமாக்குகிறது. கடுமையான வரம்புகள் எப்போதும் உடனே நடைமுறைக்கு வரும்.</string>
    <string name="settings_commitment_off">முடக்கம்</string>
    <string name="settings_commitment_delay">தாமதம்</string>
    <string name="settings_commitment_pin">PIN</string>
    <string name="settings_commitment_delay_note">வரம்புகளைத் தளர்த்தும் மாற்றங்கள் நடைமுறைக்கு வருவதற்கு முன் %1$s காத்திருக்கும்.</string>
    <string name="settings_commitment_pin_note">வரம்புகளைத் தளர்த்தும் மாற்றங்களுக்கு PIN தேவை. கூடுதல் பாதுகாப்புக்கு, நீங்கள் நம்பும் ஒருவரை அதைத் தேர்வுசெய்யச் சொல்லுங்கள்.</string>
    <string name="settings_commitment_choose_delay">மாற்றங்கள் எவ்வளவு நேரம் காத்திருக்க வேண்டும்?</string>
    <string name="settings_commitment_delay_15_minutes">15 நிமிடங்கள்</string>
    <string name="settings_commitment_delay_1_hour">1 மணிநேரம்</string>
    <string name="settings_commitment_delay_24_hours">24 மணிநேரம்</string>
    <string name="settings_commitment_choose_pin">PIN-ஐத் தேர்வுசெய்யவும்</string>
    <string name="settings_commitment_choose_pin_message">4 முதல் 6 இலக்கங்களைப் பயன்படுத்தவும். வரம்புகளைத் தளர்த்தவோ உறுதிமொழிப் பயன்முறையை முடக்கவோ இது தேவைப்படும்.</string>
    <string name="settings_commitment_confirm_pin">PIN-ஐ மீண்டும் உள்ளிடவும்</string>
    <string name="settings_commitment_pin_mismatch">PIN-கள் பொருந்தவில்லை. மீண்டும் முயலவும்.</string>
    <string name="settings_commitment_enter_pin_message">உறுதிமொழிப் பயன்முறை இயக்கத்தில் உள்ளது. இந்த மாற்றத்தைச் செய்ய PIN-ஐ உள்ளிடவும்.</string>
    <string name="settings_commitment_enter_pin">PIN-ஐ உள்ளிடவும்</string>
    <string name="settings_commitment_pin_wrong">தவறான PIN</string>
    <string name="settings_commitment_scheduled">மாற்றம் திட்டமிடப்பட்டது</string>
    <string name="settings_commitment_scheduled_message">உறுதிமொழிப் பயன்முறை இயக்கத்தில் உள்ளதால், இந்த மாற்றம் %1$s-க்கு நடைமுறைக்கு வரும். அதற்கு முன் இதை ரத்துசெய்யலாம்.</string>
    <string name="settings_commitment_cancel_change">மாற்றத்தை ரத்துசெய்</string>
    <string name="settings_commitment_confirm">உறுதிசெய்</string>
    <string name="settings_commitment_cancel">ரத்துசெய்</string>
    <string name="settings_commitment_ok">சரி</string>
